// Copy this file to Config/Secrets.xcconfig (gitignored) and fill in your
// own Supabase project's values. Never commit the populated file.
//
// xcconfig treats "//" as a comment marker, which breaks URLs pasted
// directly (https://...). Insert an empty variable reference between the
// slashes to work around it, as shown below — it still resolves to a
// normal https:// URL at build time.

SUPABASE_URL = https:/$()/xxxxxxxx.supabase.co
SUPABASE_ANON_KEY = your-anon-key-here
