# FeverLog environment configuration template.
# Copy to `.env` for local use. Never commit a populated `.env` file.
#
# Guest mode requires none of these values — the app builds, launches, and
# works fully offline without them. They are only required for Phase 9
# (Supabase authentication and household synchronization).

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase anon/public API key (safe for client distribution).
SUPABASE_ANON_KEY=
