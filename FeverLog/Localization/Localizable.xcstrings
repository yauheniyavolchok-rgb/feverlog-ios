    "onboarding.medicationSafety.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FeverLog calculates doses based on the rules you configure, but it is not medical advice. Always verify with the product label or a qualified professional."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FeverLog розраховує дози на основі налаштованих вами правил, але це не є медичною консультацією. Завжди перевіряйте інструкцію на упаковці або зверніться до кваліфікованого фахівця."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FeverLog рассчитывает дозы на основе настроенных вами правил, но это не является медицинской консультацией. Всегда сверяйтесь с инструкцией на упаковке или обратитесь к квалифицированному специалисту."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FeverLog berekent doseringen op basis van de regels die je instelt, maar dit is geen medisch advies. Controleer altijd het etiket van het product of raadpleeg een gekwalificeerde professional."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FeverLog calcula las dosis según las reglas que configures, pero no es un consejo médico. Verifica siempre la etiqueta del producto o consulta a un profesional cualificado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FeverLog berechnet Dosierungen anhand der von dir festgelegten Regeln, dies ist jedoch keine medizinische Beratung. Prüfe immer das Etikett des Produkts oder wende dich an eine qualifizierte Fachperson."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FeverLog oblicza dawki na podstawie skonfigurowanych przez Ciebie reguł, ale nie jest to porada medyczna. Zawsze sprawdzaj etykietę produktu lub skonsultuj się z wykwalifikowanym specjalistą."
          }
        }
      }
    },
