    "childForm.weight.optionalHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional — you can add or update this anytime from the child's profile."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Необов'язково — ви можете додати або оновити це будь-коли в профілі дитини."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Необязательно — вы можете добавить или изменить это в любое время в профиле ребёнка."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Optioneel — je kunt dit op elk moment toevoegen of bijwerken vanuit het profiel van je kind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opcional — puedes añadirlo o actualizarlo en cualquier momento desde el perfil del niño."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Optional — du kannst dies jederzeit im Profil des Kindes hinzufügen oder aktualisieren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opcjonalnie — możesz to dodać lub zaktualizować w dowolnym momencie w profilu dziecka."
          }
        }
      }
    },
