    "onboarding.welcome.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track temperature, medication, and symptoms for your child — fully offline, no account required."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відстежуйте температуру, ліки та симптоми вашої дитини — повністю офлайн, без реєстрації."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отслеживайте температуру, лекарства и симптомы вашего ребёнка — полностью офлайн, без регистрации."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Houd temperatuur, medicatie en symptomen van je kind bij — volledig offline, geen account nodig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Registra la temperatura, la medicación y los síntomas de tu hijo — totalmente sin conexión, sin necesidad de cuenta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erfasse Temperatur, Medikamente und Symptome deines Kindes — vollständig offline, kein Konto erforderlich."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Śledź temperaturę, leki i objawy swojego dziecka — całkowicie offline, bez konieczności zakładania konta."
          }
        }
      }
    },
